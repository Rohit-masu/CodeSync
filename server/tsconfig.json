{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"strict": false,
		"noImplicitAny": false,
		"strictNullChecks": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"moduleResolution": "node16",
		"allowSyntheticDefaultImports": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}