{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"strict": false,
		"noImplicitAny": false,
		"strictNullChecks": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"moduleResolution": "node",
		"allowSyntheticDefaultImports": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}